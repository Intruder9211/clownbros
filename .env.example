# ==============================================================================
# CLOWNBROS — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Duplicate this file as `.env.local` for local development or set these variables
# in your hosting platform (Vercel / Netlify / AWS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase / Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/clownbros?schema=public"
# Direct connection URL (optional, for connection poolers like Supabase / Neon)
DIRECT_URL="postgresql://postgres:password@localhost:5432/clownbros?schema=public"

# Initial Superadmin credentials for database seeding
ADMIN_EMAIL="admin@clownbros.com"
ADMIN_INITIAL_PASSWORD="ClownBros#2026!Secure"


# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL METADATA (Required for SEO, Sitemaps & Social Previews)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://clownbros.com

# ------------------------------------------------------------------------------
# 2. EMAIL SERVICE PROVIDER (Required for Form Submissions & Client Briefs)
# ------------------------------------------------------------------------------
# OPTION A: Resend (Recommended - 3,000 free emails/month, fastest setup)
RESEND_API_KEY=re_your_resend_api_key_here

# OPTION B: Standard SMTP (Gmail, Zoho, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here

# ------------------------------------------------------------------------------
# 3. NOTIFICATION RECIPIENTS (Where lead alerts and briefs are routed)
# ------------------------------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL=singhmohit101103@gmail.com
SENDER_EMAIL=hello@clownbros.com

# ------------------------------------------------------------------------------
# 4. INSTANT LEAD WEBHOOK ALERTS (Optional - Instant mobile pop-up for new leads)
# ------------------------------------------------------------------------------
# Discord Webhook URL to get instant lead notifications on your phone
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Or Telegram Bot (Bot Token + Chat ID)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# 5. ANALYTICS & ATTRIBUTION (Optional for Traffic & Conversion Tracking)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# 6. SPAM PROTECTION (Optional for Public Lead Forms)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key
